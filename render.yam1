services:
  - type: web
    name: mediafire-player
    runtime: python
    repo: https://github.com/yourusername/mediafire-player
    plan: free
    region: oregon
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn app:app --bind 0.0.0.0:$PORT
    envVars:
      - key: SECRET_KEY
        generateValue: true
      - key: MEDIAFIRE_URL
        value: https://www.mediafire.com/file/yr06f6vp7e5hvn6/file
        sync: false
